# Copy this file to .env at the project root and keep .env private.
# Use your Atlas connection string with NEW credentials, or this local database.
MONGODB_URI=mongodb://127.0.0.1:27017/travelmate_portfolio
# Generate a fresh value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3001
NODE_ENV=development
# Optional: set to 8.8.8.8,8.8.4.4 only if Node's Atlas DNS lookup fails locally.
# Leave blank to use the environment's default DNS servers.
DNS_SERVERS=
